{
  "name": "@futurestaff/fs-geo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./publisher": {
      "types": "./lib/publisher-types/contracts/publisher.d.ts",
      "default": "./lib/publisher.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@futurestaff/fs-platform-access"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "install:web": "npm ci --prefix source/apps/web --ignore-scripts --no-audit --no-fund"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@electric-sql/pglite": "0.5.8",
    "@futurestaff/fs-platform-access": "0.1.0",
    "react": "^18.3.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.0.2",
    "fastify": "5.12.5",
    "playwright-core": "1.64.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.25.9",
    "typescript": "^5.9.2"
  }
}
