{
  "name": "@futurestaff/fs-platform-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./interaction": {
      "types": "./lib/interaction.d.ts",
      "default": "./lib/interaction.js"
    },
    "./message-cards": {
      "types": "./lib/client/message-card.d.ts",
      "default": "./lib/client/message-card.js"
    },
    "./message-card-contract": {
      "types": "./lib/agent-message-card-contract.d.ts",
      "default": "./lib/agent-message-card-contract.js"
    },
    "./managed-settings": {
      "types": "./lib/managed-settings.d.ts",
      "default": "./lib/managed-settings.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-bundled-commerce-skills.mjs && node ../../scripts/build-managed-settings.mjs && node ../../scripts/build-dsh-client.mjs . @futurestaff/fs-platform-access",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-settings-file": "0.1.2-rc.1"
  }
}
